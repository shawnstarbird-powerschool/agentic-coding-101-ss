{
    "compilerOptions": {
      "target": "es6",
      "rootDir": "./src/",
      "outDir": "./dist/esm/",
      "noImplicitAny": false,
      "module": "esnext",
      "jsx": "react",
      "allowJs": true,
      "moduleResolution": "node",
      "declaration": true,
      "lib": ["dom"],
      "strictNullChecks": true,
      "allowSyntheticDefaultImports": true
    },
    "include": [
      "src"
    ],
    "exclude": [
      "pre-build.js",
      "post-build.js",
      "src/utils/__tests__/**.*"
    ]
  }