{
  "name": "@ps-refarch-ux/mfe-utils",
  "version": "2.20.1",
  "description": "A suite of static functions that can be imported into your project to aid in building or using micro front ends",
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    "import": "./dist/esm/index.js",
    "require": "./dist/cjs/index.js"
  },
  "publishConfig": {
    "registry": "https://artifactory.powerschoolcorp.com/artifactory/api/npm/ps-refarch-ux-npm-local"
  },
  "scripts": {
    "prebuild": "node pre-build.js",
    "build": "eslint --fix src/** && npm run build-esm && npm run build-cjs && npm run aggregate-message-keys",
    "postbuild": "node post-build.js",
    "build-esm": "tsc",
    "build-cjs": "babel src/ -d dist/cjs/ --extensions .tsx,.ts --ignore src/utils/__tests__",
    "test": "jest --no-cache --runInBand --coverage --collectCoverageFrom='./src/**/*.{ts,tsx}'",
    "test:ci": "jest --no-cache --coverage --collectCoverageFrom='./src/**/*.{ts,tsx}' --ci --reporters=default --reporters=jest-junit",
    "changelog": "changelog",
    "aggregate-message-keys": "node pull-translation-keys.js"
  },
  "keywords": [
    "Micro",
    "Front",
    "End"
  ],
  "author": "Team Voltron",
  "devDependencies": {
    "@babel/cli": "^7.20.7",
    "@babel/core": "^7.20.12",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.18.6",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "@types/jest": "^29.2.6",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@typescript-eslint/eslint-plugin": "^5.21.0",
    "@typescript-eslint/parser": "^5.21.0",
    "babel-jest": "^29.3.1",
    "del": "^6.0.0",
    "eslint": "^8.14.0",
    "eslint-webpack-plugin": "^3.1.1",
    "generate-changelog": "^1.8.0",
    "jest": "^29.3.1",
    "jest-environment-jsdom": "^29.4.1",
    "jest-localstorage-mock": "^2.4.26",
    "jest-junit": "^16.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "ts-loader": "^9.2.8",
    "typescript": "^4.6.2",
    "webpack": "^5.70.0",
    "webpack-cli": "^4.9.2",
    "react-router-dom": "6.11.1",
    "ts-morph": "^18.0.0"
  },
  "dependencies": {
    "glob-to-regexp": "^0.4.1"
  }
}
