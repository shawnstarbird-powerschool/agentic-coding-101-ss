{
  "name": "@ps-refarch-ux/neon",
  "version": "2.20.1",
  "cdnUrl": "https://assets.powerschool.com/neon",
  "description": "PowerSchool - Neon Design System",
  "main": "./lib/cjs/lib-index.js",
  "types": "./lib/cjs/lib-index.d.ts",
  "exports": {
    "import": "./lib/esm/lib-index.js",
    "require": "./lib/cjs/lib-index.js"
  },
  "publishConfig": {
    "registry": "https://artifactory.powerschoolcorp.com/artifactory/api/npm/ps-refarch-ux-npm-local"
  },
  "scripts": {
    "test": "jest --no-cache --runInBand --coverage --collectCoverageFrom='./src/{react-adapters,cdn-assets}/**/*.{ts,tsx}'",
    "test:ci": "jest --no-cache --coverage --collectCoverageFrom='./src/{react-adapters,cdn-assets}/**/*.{ts,tsx}' --ci --reporters=default --reporters=jest-junit",
    "clean": "npm run clean:all",
    "clean:dist": "node clean.js --dist=true",
    "clean:lib": "node clean.js --lib=true",
    "clean:all": "node clean.js --dist=true --lib=true",
    "help": "node help.js",
    "dev": "npm run clean:all  && npm run fix-svgs && npm run generate-illustration-list && npm run generate-theme-list && npm run generate-illustration-simple-list && npm run lib:dev && webpack serve",
    "dev:mfe": "npm run clean:all && npm run lib:artifacts && webpack serve",
    "build-icons": "npm run lib:artifacts && webpack",
    "prod": "npm run clean:all && npm run lib:dev && webpack serve --env mode=production",
    "prod:cdn": "npm run clean:all && npm run lib:dev && webpack serve --env mode=production isCdn=true",
    "artifacts": "npm run clean:all && npm run lib:artifacts && webpack --env mode=production isCdn=true && npm run aggregate-message-keys && npm run js-doc",
    "changelog": "node validate-changelog-entry-files.js && node update-changelog.js && node set-neon-version-next.js && node generate-component-changelogs.js",
    "validate-changelog-entry-files": "node validate-changelog-entry-files.js",
    "validate-documentation-unique-ids": "node validate-documentation-for-unique-ids.js",
    "changelog-entry": "node create-changelog-entry.js",
    "lib:esm": "tsc --project tsconfig.library.json",
    "lib:cjs:assets": "babel src/ -d lib/cjs/ --extensions .tsx,.ts --ignore src/app,src/cdn-assets,src/react-adapters/__tests__",
    "lib:cjs:types": "npx tsc --project tsconfig.ejs.json",
    "lib:styles": "sass ./src/cdn-assets/styles/neon-preload.scss:./lib/styles/neon-preload.css  ./src/cdn-assets/styles/neon-injected-styles.scss:./lib/styles/neon-injected-styles.css --style compressed",
    "lib:resolve-tokens": "node resolve-string-replace-tokens.js",
    "lib:dev": "npm run lib:esm && npm run lib:styles && npm run lib:resolve-tokens",
    "lib:artifacts": "npm run lib:esm && npm run lib:cjs:assets && npm run lib:styles && npm run lib:unit-test-shim && npm run lib:resolve-tokens && npm run lib:cjs:types && npm run generate-illustration-list && npm run generate-theme-list",
    "lib:unit-test-shim": "copyfiles ./unit-test-shim/**/* lib && webpack --config ./test-shim.webpack.config.js",
    "create-component": "node create-new-web-component",
    "remove-component": "node create-new-web-component --remove=true",
    "generate-illustration-list": "node generate-illustration-list.js",
    "generate-illustration-simple-list": "node generate-illustration-simple-list.js",
    "generate-theme-list": "node generate-theme-list.js",
    "generate-empty-files": "node generate-empty-files.js",
    "aggregate-message-keys": "node pull-translation-keys",
    "fix-svgs": "node correct-unique-ids-for-svgs.js",
    "js-doc": "node extract-js-doc",
    "wdio": "wdio run ./wdio.conf.ts",
    "wdio:debug": "npm run wdio wdio.conf.ts --debug=true",
    "wdio:chrome": "wdio run ./wdio.conf.ts --browser=chrome",
    "wdio:safari": "wdio run ./wdio.conf.ts --browser=safari",
    "wdio:edge": "wdio run ./wdio.conf.ts --browser=edge",
    "wdio:report": "npm run wdio --generateReport=true && npm run wdio:report-allure",
    "wdio:report-allure": "allure generate ./automation/report/allure-results --clean -o ./automation/report/allure-report && allure open ./automation/report/allure-report"
  },
  "keywords": [
    "Design",
    "System"
  ],
  "author": "Team Voltron",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/webdriverio": "^4.10.1",
    "@babel/cli": "^7.20.7",
    "@babel/core": "^7.20.12",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.18.6",
    "@floating-ui/dom": "^1.6.8",
    "@ps-refarch-ux/rtl-processor": "1.3.3",
    "@rpii/wdio-html-reporter": "^7.7.1",
    "@testing-library/react": "^13.4.0",
    "@types/jest": "^29.2.6",
    "@typescript-eslint/eslint-plugin": "^5.21.0",
    "@typescript-eslint/parser": "^5.21.0",
    "@wdio/allure-reporter": "^9.6.3",
    "@wdio/browserstack-service": "^9.8.0",
    "@wdio/cli": "^9.7.2",
    "@wdio/dot-reporter": "^9.6.3",
    "@wdio/jasmine-framework": "^9.7.3",
    "@wdio/json-reporter": "^9.6.3",
    "@wdio/junit-reporter": "^9.6.3",
    "@wdio/local-runner": "^9.7.2",
    "@wdio/spec-reporter": "^9.8.0",
    "@wdio/types": "^8.41.0",
    "@wdio/visual-service": "^6.3.1",
    "babel-jest": "^29.3.1",
    "babel-plugin-search-and-replace": "^1.1.1",
    "chromedriver": "^134.0.3",
    "comment-parser": "^1.4.0",
    "concat": "^1.0.3",
    "copy-webpack-plugin": "^10.2.4",
    "copyfiles": "^2.4.1",
    "css-loader": "^6.7.1",
    "cssnano": "^5.1.13",
    "del": "^6.0.0",
    "edgedriver": "^6.1.1",
    "eslint": "^8.14.0",
    "eslint-webpack-plugin": "^3.1.1",
    "file-loader": "^6.2.0",
    "filemanager-webpack-plugin": "^7.0.0-beta.0",
    "focus-trap": "^7.4.1",
    "fusioncharts": "^3.20.0",
    "generate-changelog": "^1.8.0",
    "glob": "^10.2.2",
    "html-loader": "^4.2.0",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^29.3.1",
    "jest-environment-jsdom": "^29.4.1",
    "jest-junit": "^16.0.0",
    "jest-localstorage-mock": "^2.4.26",
    "masonry-layout": "^4.2.2",
    "node-html-parser": "^6.1.5",
    "postcss": "^8.4.16",
    "postcss-loader": "^7.0.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-fusioncharts": "^4.0.0",
    "react-katex": "^3.0.1",
    "react-router-dom": "6.11.1",
    "react-syntax-highlighter": "^15.5.0",
    "react-test-renderer": "18.2.0",
    "remark-html": "^13.0.2",
    "remark-loader": "^5.0.0",
    "replace-in-file": "^6.3.2",
    "safaridriver": "^1.0.0",
    "sass": "^1.61.0",
    "sass-loader": "^12.6.0",
    "string-replace-loader": "^3.1.0",
    "style-loader": "^3.3.1",
    "svg-spritemap-webpack-plugin": "4.7.0",
    "ts-loader": "^9.2.8",
    "ts-morph": "^18.0.0",
    "typescript": "^4.6.3",
    "wdio-chromedriver-service": "^8.1.1",
    "wdio-html-nice-reporter": "^8.1.7",
    "webdriverio": "^8.41.0",
    "webpack": "^5.72.0",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^4.8.1",
    "webpack-plugin-replace": "^1.2.0",
    "yargs": "^17.5.1",
    "zod": "^3.22.4",
    "zod-validation-error": "^3.0.0"
  },
  "dependencies": {
    "@ps-refarch-ux/mfe-utils": "2.20.1",
    "@types/masonry-layout": "^4.2.7",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "nwsapi": "^2.2.5",
    "suneditor": "^2.47.0"
  },
  "resolutions": {
    "nwsapi": "2.2.2"
  },
  "files": [
    "lib",
    "llms-full.txt"
  ]
}
