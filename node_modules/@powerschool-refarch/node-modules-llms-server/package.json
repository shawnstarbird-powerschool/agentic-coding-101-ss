{
  "name": "@powerschool-refarch/node-modules-llms-server",
  "version": "0.2.2",
  "description": "MCP server that exposes llms.txt files from node_modules packages",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "node-modules-llms-help": "./build/nodeModulesLlmsHelp.js",
    "node-modules-llms-collect": "./build/llmsCollector.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc -w",
    "node-modules-llms-help": "node build/nodeModulesLlmsHelp.js",
    "node-modules-llms-collect": "node build/llmsCollector.js",
    "lint": "eslint \"src/**/*.ts\" \"*.js\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"*.js\"",
    "test:unit": "echo \"No unit tests\""
  },
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "llms",
    "node_modules"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "@types/fs-extra": "^11.0.1",
    "@types/yargs": "^17.0.33",
    "eslint": "^8.56.0",
    "fs-extra": "^11.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.0.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^20.0.0",
    "globals": "^15.0.0",
    "typescript-eslint": "^7.18.0"
  },
  "publishConfig": {
    "registry": "https://artifactory.powerschoolcorp.com/artifactory/api/npm/ref-arch/"
  }
}
