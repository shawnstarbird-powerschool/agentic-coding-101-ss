{
  "name": "@ps-refarch/lambda-utils",
  "version": "1.1.6",
  "license": "UNLICENSED",
  "description": "Some common lambda utils",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "del-cli coverage dist/**/*.d.ts dist/**/*.js dist/**/*.js.map test/**/*.d.ts test/**/*.js test/**/*.js.map",
    "lint": "eslint --ext .ts .",
    "lint:fix": "eslint --fix --ext .ts .",
    "test:unit": "jest --no-cache",
    "watch": "tsc -w",
    "typedoc": "npx typedoc src"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "!dist/*.spec.js",
    "!dist/*.spec.ts",
    "!dist/*.spec.d.ts",
    "llms.txt"
  ],
  "exclude": [
    "dist/test"
  ],
  "devDependencies": {
    "@types/chai": "^4.3.4",
    "chai": "^4.3.7"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.2.0",
    "@aws-sdk/client-sts": "^3.598.0",
    "@middy/http-cors": "^4.7.0",
    "jwks-rsa": "^3.0.1",
    "promise-callbacks": "^3.8.2"
  },
  "gitHead": "3d67057833904baa7aba6f3316775190b3043cde"
}
