{
  "name": "@ps-refarch/uu-utils",
  "version": "1.1.4",
  "license": "UNLICENSED",
  "description": "Unified User utils",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "del-cli coverage dist/**/*.d.ts dist/**/*.js dist/**/*.js.map test/**/*.d.ts test/**/*.js test/**/*.js.map",
    "lint": "eslint --ext .ts .",
    "lint:fix": "eslint --fix --ext .ts .",
    "test:unit": "jest --no-cache",
    "watch": "tsc -w",
    "typedoc": "npx typedoc src"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/*.spec.js",
    "!dist/*.spec.ts",
    "!dist/*.spec.d.ts",
    "resources/**/*",
    "llms.txt"
  ],
  "exclude": [
    "dist/test"
  ],
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.598.0",
    "@aws-sdk/client-secrets-manager": "^3.598.0",
    "@aws-sdk/client-ssm": "^3.598.0",
    "axios": "^1.7.2",
    "http-status-codes": "^2.3.0"
  },
  "devDependencies": {
    "@aws-sdk/util-dynamodb": "3.598.0",
    "aws-sdk-client-mock": "^4.0.1"
  },
  "gitHead": "3d67057833904baa7aba6f3316775190b3043cde"
}
