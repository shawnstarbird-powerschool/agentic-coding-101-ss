{
  "name": "@ps-refarch/feature-flag",
  "version": "1.2.5",
  "license": "UNLICENSED",
  "description": "Hello world function",
  "author": "Gary Bisaga <gary.bisaga@powerschool.com>",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "del-cli coverage dist/**/*.d.ts dist/**/*.js dist/**/*.js.map test/**/*.d.ts test/**/*.js test/**/*.js.map",
    "lint": "eslint --ext .ts .",
    "lint:fix": "eslint --fix --ext .ts .",
    "lint-feature-flags": "tsc && node dist/manage-main.js --lint true",
    "test:unit": "jest --no-cache --verbose",
    "watch": "tsc -w",
    "typedoc": "npx typedoc src"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.spec.js",
    "!dist/**/*.spec.ts",
    "!dist/**/*.spec.d.ts",
    "llms.txt"
  ],
  "bin": {
    "deploy-feature-flags": "./dist/manage-main.js"
  },
  "exclude": [
    "dist/test"
  ],
  "dependencies": {
    "@ps-refarch/env-vars": "^1.1.1",
    "axios": "^1.7.2",
    "axios-retry": "^4.4.0",
    "glob": "^10.4.1",
    "http-status-codes": "^2.3.0",
    "joi": "^17.13.1",
    "launchdarkly-node-server-sdk": "6.4.0"
  },
  "gitHead": "3d67057833904baa7aba6f3316775190b3043cde"
}
