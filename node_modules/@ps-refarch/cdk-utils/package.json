{
  "name": "@ps-refarch/cdk-utils",
  "version": "1.4.0",
  "license": "UNLICENSED",
  "description": "Some common CDK utils",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "del-cli coverage dist/**/*.d.ts dist/**/*.js dist/**/*.js.map test/**/*.d.ts test/**/*.js test/**/*.js.map",
    "lint": "yarn lint:tsc && yarn lint:ts",
    "lint:ts": "eslint --ext .ts .",
    "lint:tsc": "tsc --noEmit",
    "lint:fix": "eslint --fix --ext .ts .",
    "test:unit": "jest --no-cache",
    "watch": "tsc -w",
    "typedoc": "npx typedoc src"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/*.spec.js",
    "!dist/*.spec.ts",
    "!dist/*.spec.d.ts",
    "resources/**/*",
    "scripts/**/*",
    "llms.txt"
  ],
  "bin": {
    "get-aws-credentials": "./scripts/get-aws-credentials.sh",
    "get-deploy-account": "./scripts/get-deploy-account.js",
    "event-router-lint": "./scripts/event-router-lint.js"
  },
  "exclude": [
    "dist/test"
  ],
  "gitHead": "05bdca66d270dda1ff4359857b24b1636e16bb9e",
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.14.0",
    "@aws-sdk/client-rum": "^3.598.0",
    "@aws-sdk/client-s3": "^3.598.0",
    "@aws-sdk/client-wafv2": "^3.598.0",
    "@middy/core": "^4.7.0",
    "@types/lodash": "^4.17.5",
    "lodash": "^4.17.21",
    "ts-json-schema-generator": "^2.3.0"
  },
  "devDependencies": {
    "aws-sdk-client-mock": "^4.1.0"
  }
}
