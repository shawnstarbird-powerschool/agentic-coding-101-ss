{
  "name": "power-ftp",
  "repository": "https://github.com/classroom-new-solutions/powerftp-app.git",
  "license": "UNLICENSED",
  "scripts": {
    "add-district": "ts-node scripts/add-district.ts",
    "install:all": "npm install && cd ui && npm install && cd ..",
    "build": "cd ui && npm run artifacts",
    "clean": "del-cli coverage dist/**/*.d.ts dist/**/*.js dist/**/*.js.map test/**/*.d.ts test/**/*.js test/**/*.js.map",
    "lint": "eslint --ext .ts .",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all",
    "deploy:cd": "cdk deploy  --all --require-approval never",
    "hotswap": "cdk deploy --all --require-approval never --hotswap",
    "destroy": "cdk destroy",
    "lint:fix": "eslint --fix --ext .ts .",
    "watch": "tsc -w",
    "test": "jest --no-cache",
    "test:fix": "jest --no-cache -u",
    "test-integration": "./scripts/test_integration.sh",
    "preflight": "npm run build && npm run test:fix && npm run lint:fix",
    "postinstall": "node scripts/postinstall.js",
    "dev": "cd ui && npm run dev",
    "cf-invalidate": "ts-node scripts/cf-invalidate.ts --account-env true",
    "update-product-records": "ts-node scripts/update-product-records.ts",
    "test-init": "npm run update-product-records && ts-node scripts/write-test-data.ts",
    "get-user-config": "ts-node scripts/get-user-config.ts",
    "cwv": "lighthouse",
    "cwv:ci": "(node -e \"if (!require('fs').existsSync('./.lighthouserc.js')) { process.exit(1); }\") || (mkdir -p lighthouse && lighthouse https://`npx ts-node scripts/get-deploy-url.ts --harness true` --chrome-flags='--headless --disable-gpu --disable-dev-shm-usage --no-first-run --no-sandbox' --output-path=./lighthouse/results.html --save-assets) && (npm install -g @lhci/cli && lhci autorun)",
    "prepare": "husky",
    "zip-llms": "find . -type f -name 'llms.txt' | zip llms.zip -@"
  },
  "devDependencies": {
    "@powerschool-refarch/node-modules-llms-server": "^0.2.2",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.11.25",
    "@typescript-eslint/eslint-plugin": "^5.60.0",
    "@typescript-eslint/parser": "^5.60.0",
    "aws-cdk": "^2.1007.0",
    "aws-sdk-client-mock": "^4.1.0",
    "del-cli": "^5.0.0",
    "esbuild": "^0.25.2",
    "eslint": "^8.43.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.8.0",
    "eslint-import-resolver-typescript": "^3.5.5",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^9.0.11",
    "jest": "^29.5.0",
    "jsonwebtoken": "^9.0.2",
    "lint-staged": "^15.2.2",
    "prettier": "^2.8.8",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "~5.1.3"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-lambda-powertools/logger": "^2.6.0",
    "@aws-lambda-powertools/metrics": "^2.6.0",
    "@aws-lambda-powertools/tracer": "^2.6.0",
    "@aws-sdk/client-apigatewaymanagementapi": "^3.620.1",
    "@aws-sdk/client-dynamodb": "^3.620.1",
    "@aws-sdk/client-eventbridge": "^3.620.1",
    "@aws-sdk/client-s3": "^3.620.1",
    "@aws-sdk/client-secrets-manager": "^3.620.1",
    "@aws-sdk/client-sqs": "^3.620.1",
    "@aws-sdk/client-ssm": "^3.620.1",
    "@aws-sdk/credential-provider-node": "^3.782.0",
    "@aws-sdk/lib-dynamodb": "^3.782.0",
    "@aws-sdk/protocol-http": "^3.374.0",
    "@aws-sdk/signature-v4": "^3.374.0",
    "@aws-sdk/util-dynamodb": "^3.782.0",
    "@middy/core": "^4.7.0",
    "@middy/http-cors": "^4.7.0",
    "@powerschool-refarch/veracode-static": "^1.2.3",
    "@ps-refarch-ux/mfe-utils": "^2.20.1",
    "@ps-refarch-ux/neon": "^2.20.1",
    "@ps-refarch/alert-notifications": "^1.2.3",
    "@ps-refarch/bff-api": "^1.4.0",
    "@ps-refarch/cdk-utils": "^1.4.0",
    "@ps-refarch/district-settings": "^1.3.5",
    "@ps-refarch/env-vars": "^1.1.1",
    "@ps-refarch/feature-flag": "^1.2.5",
    "@ps-refarch/lambda-utils": "^1.1.6",
    "@ps-refarch/serverless-constructs": "^1.1.25",
    "@ps-refarch/tenants": "^1.1.22",
    "@ps-refarch/uu-utils": "^1.1.4",
    "@types/aws-lambda": "^8.10.119",
    "@types/aws4": "^1.11.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/sharp": "^0.32.0",
    "@types/uuid": "^10.0.0",
    "aws-cdk-lib": "^2.187.0",
    "aws-lambda": "^1.0.7",
    "aws4": "^1.13.2",
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "cdk-monitoring-constructs": "^7.6.0",
    "constructs": "^10.3.0",
    "dynamodb-onetable": "^2.7.7",
    "dynamodb-toolbox": "^2.0.0",
    "http-status-codes": "^2.2.0",
    "lighthouse": "^12.1.0",
    "openai": "^4.12.1",
    "sharp": "^0.34.1",
    "source-map-support": "^0.5.21",
    "ulid": "^2.3.0",
    "uuid": "^11.1.0",
    "yargs": "^17.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,js,jsx,cjs,mjs,md,yml,html,css,scss,graphql}": [
      "prettier --write"
    ]
  }
}
